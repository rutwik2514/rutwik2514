<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 880 270" width="880" height="270" role="img" aria-label="An animated character waving and asking, hey there, want to meet someone special? Click to open the profile." xmlns:c2pa="http://c2pa.org/manifest"><metadata><c2pa:manifest></c2pa:manifest></metadata>
  <title>Click to open Rutwik's profile</title>
  <defs>
    <style>
      .mono { font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace; }
    </style>
    <linearGradient id="gbg" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#0d1524"/>
      <stop offset="1" stop-color="#111b2e"/>
    </linearGradient>
    <clipPath id="say"><rect x="328" y="88" width="0" height="26">
      <animate attributeName="width" begin="0.5s" dur="1.5s" from="0" to="452" fill="freeze"/></rect></clipPath>
  </defs>

  <rect x="0" y="0" width="880" height="270" rx="14" fill="url(#gbg)"/>
  <rect x="0.5" y="0.5" width="879" height="269" rx="14" fill="none" stroke="#1d2b45"/>

  <!-- character -->
  <g transform="translate(50,30)">
    <animateTransform attributeName="transform" type="translate" additive="sum"
      values="0 0; 0 -5; 0 0" dur="3.2s" repeatCount="indefinite"/>

    <!-- hoodie -->
    <path d="M38,215 C38,168 76,148 110,148 C144,148 182,168 182,215 Z" fill="#1b2a44"/>
    <path d="M92,150 L110,176 L128,150" fill="none" stroke="#00add8" stroke-width="3" stroke-opacity="0.6"/>
    <rect x="96" y="124" width="28" height="26" rx="8" fill="#e0ab84"/>

    <!-- waving arm -->
    <g>
      <animateTransform attributeName="transform" type="rotate"
        values="-14 170 172; 16 170 172; -14 170 172" dur="1.3s" repeatCount="indefinite"/>
      <path d="M170,172 L198,124" stroke="#1b2a44" stroke-width="17" stroke-linecap="round" fill="none"/>
      <circle cx="200" cy="118" r="12" fill="#f2c8a4"/>
    </g>

    <!-- head -->
    <ellipse cx="110" cy="70" rx="57" ry="54" fill="#26344f"/>
    <ellipse cx="58" cy="86" rx="7" ry="12" fill="#f2c8a4"/>
    <ellipse cx="162" cy="86" rx="7" ry="12" fill="#f2c8a4"/>
    <ellipse cx="110" cy="82" rx="50" ry="52" fill="#f2c8a4"/>
    <path d="M56,74 C58,28 84,14 110,14 C140,14 164,28 166,74 C157,52 148,44 138,40 C130,56 114,60 102,50 C92,64 74,64 64,52 C60,58 57,66 56,74 Z" fill="#26344f"/>

    <!-- eyes -->
    <g>
      <ellipse cx="90" cy="90" rx="11" ry="13" fill="#101a2c"/>
      <ellipse cx="90" cy="92" rx="7.5" ry="9.5" fill="#00add8"/>
      <circle cx="86.5" cy="86" r="3.6" fill="#ffffff"/>
      <circle cx="93" cy="97" r="1.8" fill="#ffffff" fill-opacity="0.8"/>
      <rect x="76" y="72" width="28" height="0" fill="#f2c8a4">
        <animate attributeName="height" values="0;0;30;0;0" keyTimes="0;0.88;0.93;0.97;1" dur="5s" repeatCount="indefinite"/></rect>
      <path d="M78,76 Q90,70 102,76" stroke="#101a2c" stroke-width="4" fill="none" stroke-linecap="round"/>
    </g>
    <g>
      <ellipse cx="134" cy="90" rx="11" ry="13" fill="#101a2c"/>
      <ellipse cx="134" cy="92" rx="7.5" ry="9.5" fill="#00add8"/>
      <circle cx="130.5" cy="86" r="3.6" fill="#ffffff"/>
      <circle cx="137" cy="97" r="1.8" fill="#ffffff" fill-opacity="0.8"/>
      <rect x="120" y="72" width="28" height="0" fill="#f2c8a4">
        <animate attributeName="height" values="0;0;30;0;0" keyTimes="0;0.88;0.93;0.97;1" dur="5s" repeatCount="indefinite"/></rect>
      <path d="M122,76 Q134,70 146,76" stroke="#101a2c" stroke-width="4" fill="none" stroke-linecap="round"/>
    </g>

    <ellipse cx="72" cy="108" rx="10" ry="5" fill="#ff8fa3" fill-opacity="0.35"/>
    <ellipse cx="152" cy="108" rx="10" ry="5" fill="#ff8fa3" fill-opacity="0.35"/>
    <path d="M102,112 Q112,122 122,112" stroke="#101a2c" stroke-width="3" fill="none" stroke-linecap="round"/>
  </g>

  <!-- speech bubble -->
  <polygon points="300,98 278,112 300,126" fill="#151f33" stroke="#2a3a57"/>
  <rect x="300" y="52" width="540" height="120" rx="18" fill="#151f33" stroke="#2a3a57"/>
  <rect x="300" y="112" width="1" height="1" fill="#151f33"/>
  <text class="mono" x="328" y="108" font-size="19" fill="#e6edf7" clip-path="url(#say)">hey there, want to meet someone special?</text>
  <rect x="780" y="90" width="10" height="22" fill="#00add8">
    <animate attributeName="opacity" values="1;1;0;0" dur="1s" repeatCount="indefinite"/>
    <animate attributeName="x" begin="0.5s" dur="1.5s" from="328" to="780" fill="freeze"/>
  </rect>
  <text class="mono" x="328" y="144" font-size="13" fill="#6b819e" opacity="0">spoiler: it is me. i built the pipeline behind this page.
    <animate attributeName="opacity" begin="2.2s" dur="0.4s" to="1" fill="freeze"/></text>

  <!-- click cue -->
  <g opacity="0">
    <animate attributeName="opacity" begin="2.8s" dur="0.4s" to="1" fill="freeze"/>
    <rect x="300" y="192" width="228" height="38" rx="19" fill="#00add8" fill-opacity="0.12" stroke="#00add8" stroke-opacity="0.45">
      <animate attributeName="fill-opacity" values="0.08;0.26;0.08" dur="1.8s" repeatCount="indefinite"/></rect>
    <text class="mono" x="414" y="217" font-size="15" fill="#00add8" text-anchor="middle">click me to open</text>
  </g>
</svg>
